# Login do usuário conectado à API. Use demo para os fluxos fictícios anteriores.
VITE_AUTH_MODE=api
VITE_API_URL=http://localhost:5286
# Prefeitura demonstrativa semeada no backend; configurar por instalação.
VITE_PREFEITURA_ID=00000000-0000-0000-0000-000000000001

# Mapa do protótipo. Substitua por um provedor ou servidor municipal na implantação.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Configure VITE_MAP_ATTRIBUTION ao trocar o provedor, preservando seus créditos.
